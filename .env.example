# ─────────────────────────────────────────────────────────────────────────────
# UEE Ingestion API  –  .env.example
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=HF_TOKEN
HF_EMBEDDING_MODEL=HF_EMBEDDING_MODEL

# Max parallel HuggingFace feature-extraction calls per ingest request.
# Keep this low to avoid rate-limit errors (default: 4).
HF_EMBEDDING_CONCURRENCY=HF_EMBEDDING_CONCURRENCY

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=MONGODB_URI
MONGODB_DB=MONGODB_DB
MONGODB_COLLECTION=MONGODB_COLLECTION

# ── Chonkie / chunker settings ────────────────────────────────────────────────
# SentenceTransformer model used internally by Chonkie for semantic splitting.
# This is separate from HF_EMBEDDING_MODEL (which is for final vector storage).
CHUNKER_EMBEDDING_MODEL=CHUNKER_EMBEDDING_MODEL
# Semantic similarity threshold for chunk boundaries: low | medium | high
SIMILARITY_LEVEL=SIMILARITY_LEVEL


# Chunk size limits (in characters)
MIN_CHUNK_CHARS=MIN_CHUNK_CHARS
MAX_CHUNK_CHARS=MAX_CHUNK_CHARS

# Chunking scope: full (whole article at once) | page (page-by-page)
CHUNK_SCOPE=CHUNK_SCOPE


# ── SBG Chat API ──────────────────────────────────────────────────────────────
SBG_API_KEY=SBG_API_KEY
SBG_BASE_URL=SBG_BASE_URL

# LLM model identifier sent in the chat payload
LLM_MODEL_ID=LLM_MODEL_ID

# Maximum tokens in the model's reply
LLM_MAX_TOKENS=LLM_MAX_TOKENS

# ── Vector Search ─────────────────────────────────────────────────────────────
# Name of your MongoDB Atlas Vector Search index on the 'embedding' field.
# Create this index in Atlas UI: Database → your-collection → Search Indexes
# Index definition example:
#   { "fields": [{ "type": "vector", "path": "embedding",
#     "numDimensions": <dim>, "similarity": "cosine" }] }
MONGODB_VECTOR_INDEX=MONGODB_VECTOR_INDEX

# Number of top chunks to retrieve for each conversation query
VECTOR_SEARCH_TOP_K=VECTOR_SEARCH_TOP_K
